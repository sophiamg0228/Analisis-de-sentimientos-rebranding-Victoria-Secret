        "from transformers import AutoTokenizer, AutoModelForSequenceClassification\n",
        "from scipy.special import softmax\n",
        "import numpy as np\n",
        "\n",
        "# 1. Configuración del modelo de IA (RoBERTa optimizado para redes sociales)\n",
        "MODEL = \"cardiffnlp/twitter-roberta-base-sentiment\"\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL)\n",
        "model = AutoModelForSequenceClassification.from_pretrained(MODEL)\n",
        "\n",
        "def get_ai_sentiment(text):\n",
        "    try:\n",
        "        # Usamos text_clean porque la IA necesita el contexto (stopwords)\n",
        "        encoded_text = tokenizer(text[:512], return_tensors='pt')\n",
        "        output = model(**encoded_text)\n",
        "        scores = output[0][0].detach().numpy()\n",
        "        scores = softmax(scores)\n",
        "\n",
        "        # El modelo devuelve [0:Negativo, 1:Neutral, 2:Positivo]\n",
        "        return np.argmax(scores)\n",
        "    except:\n",
        "        return 1 # Neutral por defecto si hay error\n",
        "\n",
        "print(\"Calculando sentimientos con IA... (esto tomará 1 o 2 minutos)\")\n",
        "\n",
        "df['sentiment_score'] = df['text_clean'].apply(get_ai_sentiment)\n",
        "\n",
        "# Mapeamos a etiquetas legibles\n",
        "sentiment_map = {0: 'Negativo', 1: 'Neutral', 2: 'Positivo'}\n",
        "df['sentiment_label'] = df['sentiment_score'].map(sentiment_map)\n",
        "\n",
        "print(\"¡Análisis completado!\")\n",
        "print(df['sentiment_label'].value_counts())"
