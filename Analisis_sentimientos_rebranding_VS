        "# 4. Lematización según idioma (Simplificado para Inglés/Español)\n",
        "lemmatizer = WordNetLemmatizer()\n",
        "stop_words_en = set(stopwords.words('english'))\n",
        "stop_words_es = set(stopwords.words('spanish'))\n",
        "\n",
        "# Añadimos palabras que no aportan al análisis de marca (Custom Stopwords)\n",
        "custom_stops = {'video', 'youtube', 'channel', 'comment', 'subscribe', 'victoria', 'secret', 'vs'}\n",
