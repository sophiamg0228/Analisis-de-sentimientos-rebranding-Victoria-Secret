        "    # Convertir emojis a texto (ej: 😂 -> :face_with_tears_of_joy:)\n",
        "    text = emoji.demojize(text, delimiters=(\" \", \" \"))\n",
        "\n",
        "    # Quitar URLs (Corregido el flag)\n",
        "    text = re.sub(r'http\\S+|www\\S+|https\\S+', '', text)\n",
        "\n",
        "    # Quitar menciones (@user)\n",
        "    text = re.sub(r'@\\w+', '', text)\n",
        "\n",
        "    # Quitar caracteres especiales pero conservar el formato de los emojis demojizados (que tienen guiones bajos)\n",
        "    # y conservar letras/espacios\n",
        "    text = re.sub(r'[^\\w\\s]', ' ', text)\n",
        "\n",
        "    # Quitar números\n",
        "    text = re.sub(r'\\d+', '', text)\n",
        "\n",
        "    # Pasar a minúsculas y quitar espacios extra\n",
        "    return text.lower().strip()\n",
        "\n",
        "# 3. Función para detectar idioma (Manejo de errores si el texto es muy corto)\n",
        "def get_language(text):\n",
        "    try:\n",
        "        return detect(text)\n",
        "    except:\n",
        "        return \"unknown\"\n",
